#include <iostream>
using namespace std;

class A {
public:
    void show() {
        cout << "This is class A" << endl;
    }
};

class B {
public:
    void show() {
        cout << "This is class B" << endl;
    }
};

class C : public A, public B {
};

int main() {
    C obj;

    obj.A::show(); // Call A's function
    obj.B::show(); // Call B's function

    return 0;
}
